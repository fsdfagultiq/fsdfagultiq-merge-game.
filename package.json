{
  "name": "dim-sum-drop",
  "version": "1.0.0",
  "private": true,
  "description": "Dim Sum Drop: Night Market - a zero-build Phaser 3 merge game wrapped with Capacitor for Google Play / App Store.",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "cap:sync": "cap sync",
    "android:open": "cap open android",
    "build:android": "cd android && ./gradlew bundleRelease",
    "assets": "node scripts/generate-store-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tests/e2e.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.6.3",
    "@capacitor/core": "8.6.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.3",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-admob": "8.2.13",
    "@capgo/native-purchases": "8.11.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
